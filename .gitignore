# ============================================================
#  FACEGATE AI — Comprehensive .gitignore
# ============================================================

# ── Environment & Secrets ──────────────────────────────────
.env
.env.*
*.env
*.env.local
*.env.*.local
!*.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets/

# ── Python ────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ── Node.js & Next.js ─────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ── AI Models & Heavy Data ────────────────────────────────
ai-service/models/*.onnx
ai-service/models/*.bin
ai-service/models/*.pt
ai-service/models/*.pth
ai-service/models/*.engine
ai-service/models/*.tar.gz
ai-service/data/
ai-service/data/*
!ai-service/data/.gitkeep
data/known_faces/
data/unknown_faces/

# ── Database & Persistent Storage ─────────────────────────
postgres-data/
**/postgres-data/
redis-data/
**/redis-data/
*.db
*.sqlite
*.sqlite3

# ── Logs & Temporary Files ────────────────────────────────
logs/
**/logs/
*.log
*.log.*
*.tmp
*.bak
*.swp
*~

# ── OS & IDE Artifacts ────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.user
