# ============================================================
#  FACEGATE AI — Backend Environment Configuration Example
# ============================================================

# API
API_V1_STR=/api/v1
PROJECT_NAME=FaceGate AI
DEBUG=True

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_SERVICE_KEY=facegate-internal-secret-key

# ============================================================
#  Database — PostgreSQL (Port 5432)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/facegate_ai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facegate_ai
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================
#  Redis & Message Broker
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
#  Microservices
# ============================================================
AI_SERVICE_URL=http://localhost:8001
DEVICE_SERVICE_URL=http://localhost:8002

# ============================================================
#  CORS & Security Origins
# ============================================================
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]

# ============================================================
#  Face Recognition Parameters
# ============================================================
FACE_RECOGNITION_THRESHOLD=0.6
MAX_FACE_ENROLLMENT=10

