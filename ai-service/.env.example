# ============================================================
#  FACEGATE AI — AI Microservice Environment Configuration Example
# ============================================================
PROJECT_NAME="FaceGate AI Service"
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=False

REDIS_URL=redis://localhost:6379

DETECTION_MODEL=retinaface_r50_v1
RECOGNITION_MODEL=arcface_r100_v1
DETECTION_THRESHOLD=0.5
RECOGNITION_THRESHOLD=0.6

MODELS_DIR=models
DATA_DIR=data
KNOWN_FACES_DIR=data/known_faces
UNKNOWN_FACES_DIR=data/unknown_faces

MAX_IMAGE_SIZE=1920
EMBEDDING_DIMENSION=512
BATCH_SIZE=16

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

